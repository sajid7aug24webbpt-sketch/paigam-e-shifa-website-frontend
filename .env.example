# Public API + site URL used by the frontend.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Live site URL (used by sitemap.xml / robots.txt / OG URLs).
NEXT_PUBLIC_SITE_URL=https://paigam-e-shifa.netlify.app
# Server-only: internal API base for server-side fetches (Docker). When the
# frontend runs in a container, the browser-facing API URL above is not
# reachable from inside the container, so set this to the backend service
# URL, e.g. API_URL_INTERNAL=http://backend:5000/api
# API_URL_INTERNAL=http://backend:5000/api
